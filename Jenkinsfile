// EasyCRUD DevSecOps pipeline. Runs ONLY on the private build agent (label: build-agent).
//
// Nothing secret is stored in Jenkins for AWS or the database:
//   * AWS access comes from the agent's IAM instance role (ECR push, eks:DescribeCluster, read ONE secret).
//   * The DB password is generated by RDS, lives in Secrets Manager, and is copied into a Kubernetes Secret at deploy time.
//   * The only Jenkins credential is the SonarQube token (configured under Manage Jenkins -> System).
// Infrastructure is NOT changed here. It is applied separately with Terraform (see README).

pipeline {
    agent { label 'build-agent' }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(name: 'DEPLOY', defaultValue: true,
                     description: 'Deploy to production after all scans pass (asks for approval first)')
    }

    environment {
        AWS_REGION         = 'us-east-1'
        AWS_DEFAULT_REGION = 'us-east-1'
        CLUSTER_NAME       = 'easycrud-prod'      // = "<project>-<environment>" from Terraform
        NAMESPACE          = 'easycrud'
        DB_INSTANCE_ID     = 'easycrud-prod-db'
        BACKEND_REPO       = 'easycrud/backend'
        FRONTEND_REPO      = 'easycrud/frontend'
        APPROVERS          = ''                   // Jenkins user IDs / groups allowed to approve; empty = anyone who can run the job
        DOCKER_CONFIG      = "${WORKSPACE}/.docker" // keep registry logins inside the workspace, deleted at the end
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def sha = sh(returnStdout: true, script: 'git rev-parse --short=7 HEAD').trim()
                    env.IMAGE_TAG      = "${env.BUILD_NUMBER}-${sha}"   // unique + traceable; ECR tags are immutable
                    env.ECR_REGISTRY   = sh(returnStdout: true,
                        script: 'echo "$(aws sts get-caller-identity --query Account --output text).dkr.ecr.${AWS_REGION}.amazonaws.com"').trim()
                    env.BACKEND_IMAGE  = "${env.ECR_REGISTRY}/${env.BACKEND_REPO}:${env.IMAGE_TAG}"
                    env.FRONTEND_IMAGE = "${env.ECR_REGISTRY}/${env.FRONTEND_REPO}:${env.IMAGE_TAG}"
                    echo "Building ${env.BACKEND_IMAGE} and ${env.FRONTEND_IMAGE}"
                }
            }
        }

        stage('Secret scan (Gitleaks)') {
            steps {
                sh 'gitleaks detect --source . --redact --no-banner --exit-code 1'
            }
        }

        stage('Backend: unit tests + SonarQube') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonarqube') {
                        sh 'mvn -B verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=easycrud-backend -Dsonar.projectName=easycrud-backend'
                    }
                }
            }
        }

        stage('Quality gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Dependency + secret scan (Trivy fs)') {
            steps {
                sh 'trivy fs --scanners vuln,secret --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --skip-dirs node_modules --skip-dirs backend/target .'
            }
        }

        stage('Config scan (Dockerfiles + Kubernetes)') {
            steps {
                sh 'trivy config --severity HIGH,CRITICAL --exit-code 1 backend frontend k8s'
            }
        }

        stage('Build images') {
            steps {
                sh '''#!/bin/bash -e
docker build -t "$BACKEND_IMAGE" backend
docker build -t "$FRONTEND_IMAGE" frontend
'''
            }
        }

        stage('Image scan (Trivy)') {
            steps {
                sh '''#!/bin/bash -e
trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 "$BACKEND_IMAGE"
trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 "$FRONTEND_IMAGE"
'''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''#!/bin/bash -e
aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
docker push "$BACKEND_IMAGE"
docker push "$FRONTEND_IMAGE"
'''
            }
        }

        stage('Approval') {
            when { expression { return params.DEPLOY } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Deploy ${env.IMAGE_TAG} to PRODUCTION?", ok: 'Deploy', submitter: env.APPROVERS
                }
            }
        }

        stage('Deploy to EKS') {
            when { expression { return params.DEPLOY } }
            steps {
                script { env.DEPLOY_STARTED = 'true' }
                sh '''#!/bin/bash -e
set -o pipefail

aws eks update-kubeconfig --region "$AWS_REGION" --name "$CLUSTER_NAME"
kubectl config set-context --current --namespace="$NAMESPACE"

# --- Database connection: discovered and read at deploy time. Never stored in Jenkins or Git. ---
DB_INFO=$(aws rds describe-db-instances --db-instance-identifier "$DB_INSTANCE_ID" \
  --query 'DBInstances[0].[Endpoint.Address,Endpoint.Port,DBName,MasterUserSecret.SecretArn]' --output text)
read -r DB_HOST DB_PORT DB_NAME SECRET_ARN <<< "$DB_INFO"

SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" --query SecretString --output text)
ENV_FILE=$(mktemp)            # created with mode 600
trap 'rm -f "$ENV_FILE"' EXIT
{
  echo "DB_URL=jdbc:mariadb://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslMode=trust"
  echo "DB_USERNAME=$(jq -r .username <<< "$SECRET_JSON")"
  echo "DB_PASSWORD=$(jq -r .password <<< "$SECRET_JSON")"
} > "$ENV_FILE"
kubectl create secret generic easycrud-db --from-env-file="$ENV_FILE" --dry-run=client -o yaml | kubectl apply -f -

# --- Validate every manifest against the live API first, then apply ---
MANIFESTS="k8s/10-backend.yaml k8s/20-frontend.yaml k8s/30-ingress.yaml k8s/40-networkpolicy.yaml"
for f in $MANIFESTS; do
  envsubst '${BACKEND_IMAGE} ${FRONTEND_IMAGE}' < "$f" | kubectl apply --dry-run=server -f -
done
for f in $MANIFESTS; do
  envsubst '${BACKEND_IMAGE} ${FRONTEND_IMAGE}' < "$f" | kubectl apply -f -
done

kubectl rollout status deployment/backend  --timeout=300s
kubectl rollout status deployment/frontend --timeout=300s
kubectl get pods,svc,ingress

HOST=$(kubectl get ingress easycrud -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
echo "Application URL: http://${HOST:-<ALB still provisioning, check again in a minute>}"
'''
            }
        }
    }

    post {
        failure {
            script {
                if (env.DEPLOY_STARTED == 'true') {
                    sh '''#!/bin/bash
kubectl -n "$NAMESPACE" rollout undo deployment/backend  || true
kubectl -n "$NAMESPACE" rollout undo deployment/frontend || true
'''
                }
            }
        }
        always {
            sh 'docker logout "$ECR_REGISTRY" || true'
            sh 'docker image prune -f || true'
            deleteDir()
        }
    }
}
